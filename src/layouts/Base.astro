---
import site from '../content/site.json';
const { title = 'NAOBA', page = '' } = Astro.props;
const nav = [
  { href: './dance.html', label: 'Dance', key: 'dance' },
  { href: './listen.html', label: 'Listen', key: 'listen' },
  { href: './journeys.html', label: 'Journeys', key: 'journeys' },
  { href: './film.html', label: 'Film', key: 'film' },
  { href: './shop.html', label: 'Samples & Tools', key: 'shop' },
  { href: './mentorship.html', label: 'Mentorship', key: 'mentorship' },
  { href: './contact.html', label: 'Contact', key: 'contact' }
];
import Signup from '../components/Signup.astro';
import Social from '../components/Social.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={site.intro} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Italiana&family=Jost:wght@300;400;500&family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=IM+Fell+English:ital@1&family=IBM+Plex+Mono:wght@300&display=swap" rel="stylesheet" />
</head>
<body class={page}>
<header class="bar" id="bar">
  <a class="home" href="./index.html">NAOBA</a>
  <nav aria-label="Main" class="desk">
    {nav.map(n => <a href={n.href} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <details class="mob">
    <summary>Menu</summary>
    <nav aria-label="Main">{nav.map(n => <a href={n.href} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>)}</nav>
  </details>
</header>
<slot />
<footer class="foot">
  <Signup variant="foot" />
  <Social />
  {site.person && <p class="small mono">NAOBA is {site.person}</p>}
</footer>
<script is:inline>
if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.querySelectorAll('video[autoplay]').forEach(v => { v.removeAttribute('autoplay'); try { v.pause(); } catch (e) {} });
}
</script>
<style is:global>
@font-face{font-family:'Toreadore';src:url('./fonts/toreadore.woff2?v=1') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Nova';src:url('./fonts/nova-bold.woff2?v=1') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Butterbrotpapier';src:url('./fonts/butterbrotpapier.woff2?v=3') format('woff2');font-display:swap}
:root{--navh:64px;--black:#000;--noche:#0F2619;--moss:#5A6431;--gold:#BC9855;--copal:#D9772A;--cacao:#1a100a;
--bg:#F3EEE2;--obsidian:#E9E1CF;--maize:#3b2f22;--lgold:#93702F;--line:rgba(80,60,30,.18);--cardbg:rgba(255,255,255,.55);
--head:'Italiana',Georgia,serif;--title:'Italiana',Georgia,serif;--sans:'Jost',system-ui,sans-serif;--fell:'Fraunces',Georgia,serif;--body:'Fraunces',Georgia,serif;--mono:'IBM Plex Mono',ui-monospace,monospace}
*{box-sizing:border-box}
.center-text{text-align:center}
.page-hero h1{white-space:pre-line}
.band,.page-hero .wrap{text-align:center}
.band .lede,.band .italic,.band p{margin-left:auto;margin-right:auto}
.band .lede,.band .italic{max-width:62ch}
.list{max-width:720px;margin-left:auto !important;margin-right:auto !important}
.list li{grid-template-columns:1fr !important;justify-items:center;text-align:center;gap:4px}
.grid2>*,.grid3>*{text-align:center}
.card ul,.card ol{text-align:center;padding-left:0}
form,.form{text-align:left;max-width:640px;margin-left:auto;margin-right:auto}
.one-video{max-width:900px;margin:0 auto}

.dark,.band.noche,.band.cacao,.page-hero,.foot{--maize:#EFE3C8;--lgold:#E6C37F;--line:rgba(240,198,124,.16);--obsidian:#0b0907;--cardbg:rgba(0,0,0,.25);color:var(--maize)}
.bar.solid,body:not(.home) .bar{background:rgba(243,238,226,.94);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom-color:var(--line)}
.bar.solid a,body:not(.home) .bar a,.bar.solid .mob summary,body:not(.home) .bar .mob summary{color:#3b2f22}
.bar.solid nav a[aria-current],body:not(.home) .bar nav a[aria-current]{color:var(--gold)}
html{scroll-padding-top:var(--navh)}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--bg);color:var(--maize);font:350 17px/1.75 var(--body)}
a{color:var(--lgold)}
a:hover{color:var(--copal)}
a:focus-visible,button:focus-visible{outline:2px solid var(--copal);outline-offset:3px}
img,video{max-width:100%;display:block}
.bar{position:fixed;top:0;left:0;right:0;z-index:50;height:var(--navh);transition:background .4s,border-color .4s;border-bottom:1px solid transparent;display:flex;justify-content:center;gap:48px;align-items:center;padding:0 28px;font:400 12.5px/1 var(--sans);letter-spacing:.2em;text-transform:uppercase}
.bar a{color:#F6EFE0;text-decoration:none}
.bar a:hover{color:var(--gold)}
.bar nav{display:flex;gap:30px}
.mob{display:none}
.mob summary{list-style:none;cursor:pointer;color:#F6EFE0;font:500 11px/1 var(--sans);letter-spacing:.2em;border:1px solid var(--gold);padding:8px 14px;border-radius:0}
.mob summary::-webkit-details-marker{display:none}
.mob nav{position:absolute;right:18px;top:58px;flex-direction:column;gap:16px;background:#F3EEE2;border:1px solid var(--line);padding:20px 26px}
.mob nav a{color:#3b2f22 !important}
.bar nav a[aria-current]{color:var(--gold)}
.bar .home{font:400 22px/1 var(--title);letter-spacing:.18em}
.wrap{max-width:74rem;margin:0 auto;padding:0 28px}
.band{padding:96px 0;position:relative}
.band.noche{background:var(--noche)}
.band.cacao{background:var(--cacao)}
.h1{font-family:var(--title);font-weight:400;font-size:clamp(48px,7.4vw,100px);line-height:1.02;letter-spacing:.05em;color:var(--lgold);margin:0}
.h2{font-family:var(--title);font-weight:400;font-size:clamp(38px,5vw,64px);line-height:1.08;letter-spacing:.05em;color:var(--lgold);margin:0 0 18px}
.h3{font-family:var(--title);font-weight:400;font-size:27px;letter-spacing:.04em;color:var(--lgold);margin:0 0 6px}
.italic,.lede{font-family:var(--fell);font-style:normal;font-weight:350;font-size:clamp(18px,1.8vw,21px);line-height:1.5;color:var(--maize);max-width:40ch;margin:0 0 28px}
.mono{font:400 12px/1.5 var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--lgold)}
.small{font-size:14px}
.btn{display:inline-block;font:500 12px/1 var(--sans);letter-spacing:.22em;text-transform:uppercase;text-decoration:none;padding:16px 34px;border-radius:0;border:1px solid var(--gold);color:#fff;background:var(--gold);cursor:pointer;transition:background .3s,border-color .3s}
.btn:hover{background:#A47F3D;border-color:#A47F3D;color:#fff}
.btn.solid{background:var(--gold)}
.btn.copal{background:var(--copal);border-color:var(--copal)}
.btn.copal:hover{background:#B9601F;border-color:#B9601F}
.divider{display:block;width:100%;max-width:520px;height:22px;margin:0 auto}
.page-hero{position:relative;min-height:72vh;display:flex;align-items:flex-end;overflow:hidden}
.page-hero > img,.page-hero > video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.5)}
.page-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.6) 0%,rgba(0,0,0,.15) 55%,rgba(0,0,0,.4) 100%)}
.page-hero .wrap{position:relative;z-index:2;padding-bottom:72px;width:100%;text-align:center}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.card{border:1px solid var(--line);padding:28px;border-radius:0;background:var(--cardbg)}
.card p{margin:0}
.frame{position:relative}
.frame::before,.frame::after{content:'';position:absolute;width:22px;height:22px;border:1px solid var(--gold);z-index:2;pointer-events:none}
.frame::before{top:-8px;left:-8px;border-right:0;border-bottom:0}
.frame::after{bottom:-8px;right:-8px;border-left:0;border-top:0}
.video{position:relative;aspect-ratio:16/9;background:var(--noche);border:1px solid var(--moss);display:grid;place-items:center;overflow:hidden}
.video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.video .soon{font-family:var(--head);color:var(--lgold);font-size:20px;text-align:center;padding:0 16px}
.list{list-style:none;padding:0;margin:0}
.list li{display:grid;grid-template-columns:1fr auto;gap:18px;padding:14px 0;border-top:1px solid var(--line)}
.foot{border-top:1px solid var(--line);padding:90px 28px 44px;text-align:center;background:#0F2619}
.foot .news{max-width:560px;margin:0 auto 40px}
.foot .lede{margin:0 auto 22px}
.foot iframe{width:100%;max-width:480px;height:150px;border:1px solid var(--moss);background:#fff;border-radius:2px}
.foot .links{display:flex;flex-wrap:wrap;justify-content:center;gap:22px;font:400 12px/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;margin-bottom:24px}
.foot .links a{text-decoration:none}
@media (max-width:820px){
  .bar{padding:0 18px;justify-content:space-between}.desk{display:none !important}.mob{display:block}
  .wrap{padding:0 20px}.band{padding:64px 0}
  .grid3,.grid2{grid-template-columns:1fr}
  .list li{grid-template-columns:1fr;gap:4px}
  .card{padding:22px}
  .h2{font-size:clamp(34px,9vw,44px)}
  .btn{padding:15px 26px}
}
</style>
<script is:inline>
(function(){var b=document.getElementById('bar');if(!b)return;function f(){b.classList.toggle('solid',window.scrollY>40)}f();window.addEventListener('scroll',f,{passive:true});})();
</script>
</body>
</html>
