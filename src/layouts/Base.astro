---
import site from '../content/site.json';
const { title = 'NAOBA', page = '' } = Astro.props;
const nav = [
  { href: './dance.html', label: 'Dance', key: 'dance' },
  { href: './listen.html', label: 'Listen', key: 'listen' },
  { href: './film.html', label: 'Film', key: 'film' },
  { href: './shop.html', label: 'Shop', key: 'shop' },
  { href: './mentorship.html', label: 'Mentorship', key: 'mentorship' },
  { href: './contact.html', label: 'Contact', key: 'contact' }
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={site.intro} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=IBM+Plex+Mono:wght@300&display=swap" rel="stylesheet" />
</head>
<body class={page}>
<header class="bar">
  <a class="home" href="./index.html">NAOBA</a>
  <nav aria-label="Main" class="desk">
    {nav.map(n => <a href={n.href} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <details class="mob">
    <summary>Menu</summary>
    <nav aria-label="Main">{nav.map(n => <a href={n.href} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>)}</nav>
  </details>
</header>
<slot />
<footer class="foot">
  <div class="news">
    <h2 class="h2">Letters from the forest</h2>
    <p class="lede">New music, gatherings and field notes, straight to your inbox through Substack.</p>
    <iframe src={site.substack_embed} title="Subscribe to Heart in Nature on Substack" loading="lazy"></iframe>
    <p class="small"><a href={site.substack}>Read past letters on Substack</a></p>
  </div>
  <div class="links">
    <a href={site.kofi}>Ko-fi</a><a href={site.substack}>Substack</a><a href={site.soundcloud}>SoundCloud</a><a href={site.spotify}>Spotify</a><a href={site.bandcamp}>Bandcamp</a><a href={site.instagram}>Instagram</a><a href={site.youtube}>YouTube</a>
  </div>
  <p class="small mono">NAOBA is {site.person}</p>
</footer>
<script is:inline>
if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.querySelectorAll('video[autoplay]').forEach(v => { v.removeAttribute('autoplay'); try { v.pause(); } catch (e) {} });
}
</script>
<style is:global>
@font-face{font-family:'Butterbrotpapier';src:url('./fonts/butterbrotpapier.woff2') format('woff2');font-display:swap}
:root{--black:#000;--obsidian:#0b0907;--noche:#0F2619;--moss:#5A6431;--gold:#C9984A;--lgold:#F0C67C;--copal:#E8822A;--cacao:#1a100a;--maize:#EFE3C8;--line:#2b2a1c;
--head:'Butterbrotpapier',Georgia,serif;--fell:'Figtree',system-ui,sans-serif;--body:'Figtree',system-ui,sans-serif;--mono:'IBM Plex Mono',ui-monospace,monospace}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--black);color:var(--maize);font:400 17px/1.7 var(--body)}
a{color:var(--lgold)}
a:hover{color:var(--copal)}
a:focus-visible,button:focus-visible{outline:2px solid var(--copal);outline-offset:3px}
img,video{max-width:100%;display:block}
.bar{position:absolute;top:0;left:0;right:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:20px 28px;font-family:var(--head);font-size:19px;letter-spacing:.05em}
.bar a{color:var(--lgold);text-decoration:none}
.bar nav{display:flex;gap:24px}
.mob{display:none}
.mob summary{list-style:none;cursor:pointer;color:var(--lgold);border:1px solid var(--gold);padding:4px 14px;border-radius:2px}
.mob summary::-webkit-details-marker{display:none}
.mob nav{position:absolute;right:18px;top:58px;flex-direction:column;gap:14px;background:var(--obsidian);border:1px solid var(--moss);padding:18px 24px;font-size:20px}
.bar nav a[aria-current]{color:var(--copal)}
.bar .home{font-size:22px;letter-spacing:.12em}
.wrap{max-width:74rem;margin:0 auto;padding:0 28px}
.band{padding:96px 0;position:relative}
.band.noche{background:var(--noche)}
.band.cacao{background:var(--cacao)}
.h1{font-family:var(--head);font-weight:400;text-transform:uppercase;font-size:clamp(46px,7vw,92px);line-height:1;letter-spacing:.04em;color:var(--lgold);margin:0}
.h2{font-family:var(--head);font-weight:400;text-transform:uppercase;font-size:clamp(32px,4.4vw,52px);line-height:1.05;letter-spacing:.03em;color:var(--lgold);margin:0 0 18px}
.h3{font-family:var(--head);font-weight:400;font-size:24px;letter-spacing:.02em;color:var(--lgold);margin:0 0 6px}
.italic,.lede{font-family:var(--fell);font-style:normal;font-weight:400;font-size:clamp(18px,1.8vw,21px);line-height:1.5;color:var(--maize);max-width:40ch;margin:0 0 28px}
.mono{font-family:var(--mono);font-size:12px;letter-spacing:.03em;color:var(--gold)}
.small{font-size:14px}
.btn{display:inline-block;font-family:var(--head);font-size:18px;letter-spacing:.05em;text-decoration:none;padding:10px 22px;border-radius:2px;border:1px solid var(--gold);color:var(--lgold);background:transparent;cursor:pointer}
.btn:hover{background:var(--gold);color:var(--black)}
.btn.solid{background:var(--gold);color:var(--black)}
.btn.solid:hover{background:var(--lgold)}
.btn.copal{border-color:var(--copal);color:var(--copal)}
.btn.copal:hover{background:var(--copal);color:var(--black)}
.divider{display:block;width:100%;max-width:520px;height:22px;margin:0 auto}
.page-hero{position:relative;min-height:72vh;display:flex;align-items:flex-end;overflow:hidden}
.page-hero > img,.page-hero > video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.5)}
.page-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,#000 0%,rgba(0,0,0,.2) 55%,rgba(0,0,0,.45) 100%)}
.page-hero .wrap{position:relative;z-index:2;padding-bottom:64px;width:100%}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.card{border:1px solid var(--line);padding:26px;border-radius:2px;background:rgba(0,0,0,.25)}
.card p{margin:0}
.frame{position:relative}
.frame::before,.frame::after{content:'';position:absolute;width:22px;height:22px;border:1px solid var(--gold);z-index:2;pointer-events:none}
.frame::before{top:-8px;left:-8px;border-right:0;border-bottom:0}
.frame::after{bottom:-8px;right:-8px;border-left:0;border-top:0}
.video{position:relative;aspect-ratio:16/9;background:var(--noche);border:1px solid var(--moss);display:grid;place-items:center;overflow:hidden}
.video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.video .soon{font-family:var(--head);color:var(--lgold);font-size:20px;text-align:center;padding:0 16px}
.list{list-style:none;padding:0;margin:0}
.list li{display:grid;grid-template-columns:1fr auto;gap:18px;padding:14px 0;border-top:1px solid var(--line)}
.foot{border-top:1px solid var(--line);padding:80px 28px 40px;text-align:center;background:var(--obsidian)}
.foot .news{max-width:560px;margin:0 auto 40px}
.foot .lede{margin:0 auto 22px}
.foot iframe{width:100%;max-width:480px;height:150px;border:1px solid var(--moss);background:#fff;border-radius:2px}
.foot .links{display:flex;flex-wrap:wrap;justify-content:center;gap:18px;font-family:var(--head);font-size:18px;margin-bottom:20px}
.foot .links a{text-decoration:none}
@media (max-width:820px){
  .bar{padding:16px 18px}.desk{display:none !important}.mob{display:block}
  .wrap{padding:0 20px}.band{padding:64px 0}
  .grid3,.grid2{grid-template-columns:1fr}
}
</style>
</body>
</html>
