---
// Petroglyph-inspired emblems in fine gold line (sketches, to be redrawn from Ometepe photos).
const { name = 'spiral', size = 44, color = 'var(--gold)' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 40 40" fill="none" stroke={color} stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
  {name === 'spiral' && <path d="M20 20a2 2 0 0 1 4 0a5 5 0 0 1-10 0a8 8 0 0 1 16 0a11 11 0 0 1-22 0a14 14 0 0 1 28 0"/>}
  {name === 'double' && <path d="M12 20a2 2 0 0 1 3 0a4 4 0 0 1-7 2a6 6 0 0 1 9-6q3 4 6 4a6 6 0 0 0 9-6a4 4 0 0 0-7 2a2 2 0 0 0 3 0"/>}
  {name === 'square' && <path d="M20 20h4v-4h-8v8h12v-12h-16v16h20v-20h-24"/>}
  {name === 'sun' && <g><circle cx="20" cy="20" r="7"/><path d="M20 5v6M20 29v6M5 20h6M29 20h6M9 9l4 4M27 27l4 4M31 9l-4 4M9 31l4-4"/></g>}
  {name === 'turtle' && <g><ellipse cx="20" cy="21" rx="9" ry="11"/><circle cx="20" cy="7" r="3"/><path d="M11 15l-5-3M29 15l5-3M11 27l-5 3M29 27l5 3M20 32v4"/></g>}
  {name === 'temple' && <path d="M4 30h6v-8h6v-8h8v8h6v8h6"/>}
</svg>
