---
// A YouTube video in a gold frame. Empty id = "coming soon" card.
const { id = '', title = '' } = Astro.props;
---
<figure class="frame" style="margin:0">
  <div class="video">
    {id
      ? <iframe src={`https://www.youtube-nocookie.com/embed/${id}`} title={title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      : <p class="soon">{title}<br /><span class="mono">Video coming soon</span></p>}
  </div>
</figure>
