---
// Fine-line cymatic / sacred-geometry figure, drawn from math (no image file)
const { size = 160, petals = 6, spin = true, opacity = 1, color = 'currentColor', cls = '' } = Astro.props;
const C = 100, f = (n) => n.toFixed(2);
const rose = (k, R, rot = 0, steps = 720) => {
  let d = '';
  for (let i = 0; i <= steps; i++) {
    const t = (i / steps) * Math.PI * 2;
    const r = R * Math.cos(k * t);
    const x = C + r * Math.cos(t + rot), y = C + r * Math.sin(t + rot);
    d += (i ? 'L' : 'M') + f(x) + ' ' + f(y);
  }
  return d;
};
const star = (n, skip, R) => {
  const pts = Array.from({ length: n }, (_, i) => { const a = -Math.PI / 2 + (i * 2 * Math.PI) / n; return [C + R * Math.cos(a), C + R * Math.sin(a)]; });
  let d = '', i = 0;
  for (let s = 0; s <= n; s++) { const [x, y] = pts[i]; d += (s ? 'L' : 'M') + f(x) + ' ' + f(y); i = (i + skip) % n; }
  return d;
};
const ticks = Array.from({ length: 96 }, (_, i) => {
  const a = (i * 2 * Math.PI) / 96, long = i % 8 === 0, mid = i % 4 === 0;
  const r1 = 92, r2 = long ? 85 : mid ? 88 : 90;
  return `M${f(C + r1 * Math.cos(a))} ${f(C + r1 * Math.sin(a))}L${f(C + r2 * Math.cos(a))} ${f(C + r2 * Math.sin(a))}`;
}).join('');
const flower = [[0, 0], ...Array.from({ length: 6 }, (_, i) => [22 * Math.cos(i * Math.PI / 3), 22 * Math.sin(i * Math.PI / 3)])];
---
<svg class={`cym ${spin ? 'spin' : ''} ${cls}`} viewBox="0 0 200 200" width={size} height={size} aria-hidden="true" style={`color:${color};opacity:${opacity}`}>
  <g fill="none" stroke="currentColor" stroke-width="0.35">
    <circle cx="100" cy="100" r="96" />
    <circle cx="100" cy="100" r="92" />
    <path d={ticks} />
    <circle cx="100" cy="100" r="66" stroke-dasharray="0.6 2.2" />
    <path d={star(12, 5, 84)} opacity=".7" />
    <g class="r1"><path d={rose(petals, 70)} /></g>
    <g class="r2"><path d={rose(petals / 2 * 3 / 1.5 * 1, 52, Math.PI / (petals * 2))} opacity=".75" /></g>
    {flower.map(([x, y]) => <circle cx={f(C + x)} cy={f(C + y)} r="22" opacity=".8" />)}
    <circle cx="100" cy="100" r="44" />
    <circle cx="100" cy="100" r="2.2" fill="currentColor" stroke="none" />
  </g>
</svg>
<style>
.cym{display:inline-block;overflow:visible}
@media (prefers-reduced-motion:no-preference){
  .cym.spin .r1{transform-origin:100px 100px;animation:cymspin 140s linear infinite}
  .cym.spin .r2{transform-origin:100px 100px;animation:cymspin 200s linear infinite reverse}
}
@keyframes cymspin{to{transform:rotate(360deg)}}
</style>
