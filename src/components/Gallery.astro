---
const { items = [], cols: colsProp } = Astro.props;
const n = items.length;
const cols = colsProp ?? (n <= 1 ? 1 : n === 2 || n === 4 ? 2 : 3);
---
<div class="gal" style={`--cols:${cols}`}>
  {items.map(it => (
    <figure class={`g ${it.wide || n === 1 ? 'wide' : ''} ${it.tall ? 'tall' : ''}`}>
      <img src={it.src} alt={it.alt} loading="lazy" />
      {it.caption && <figcaption>{it.caption}</figcaption>}
    </figure>
  ))}
</div>
<style>
.gal{display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));gap:14px;grid-auto-flow:dense}
.g{margin:0;position:relative;overflow:hidden;aspect-ratio:4/3;background:#0b1a11}
.g.wide{grid-column:span 2;aspect-ratio:auto}
.g.wide img{max-height:78vh}
.gal[style='--cols:1'] .g.wide{grid-column:span 1}
.g.tall{grid-row:span 2;aspect-ratio:auto}
.g img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.2s ease}
.g:hover img{transform:scale(1.03)}
.g figcaption{position:absolute;left:0;right:0;bottom:0;padding:22px 12px 10px;font:400 10.5px/1.4 var(--sans);letter-spacing:.18em;text-transform:uppercase;color:#F6EFE0;background:linear-gradient(to top,rgba(0,0,0,.7),transparent)}
@media (max-width:820px){.gal{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.g.wide{grid-column:span 2}.g.tall{grid-row:auto;aspect-ratio:4/3}}
</style>
