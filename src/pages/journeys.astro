---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import Glyph from '../components/Glyph.astro';
import j from '../content/journeys.json';
const T = j.titles;
---
<Base title="Journeys, NAOBA" page="journeys">
<section class="page-hero">
  <img src={j.hero.image} alt="" />
  <div class="wrap">
    <p class="mono">{j.hero.kicker}</p>
    <h1 class="h1">{j.hero.title}</h1>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <p class="italic" style="white-space:pre-line">{j.intro}</p>
  </div>
</section>

<section class="band noche">
  <div class="wrap">
    <h2 class="h2">{T.kinds}</h2>
    <div class="grid2 kinds">
      {j.kinds.map((k, i) => <div class="card">{k.icon ? <img class="card-icon" src={k.icon} alt="" width="84" height="84" loading="lazy" /> : <Glyph name={i ? 'sun' : 'spiral'} />}<h3 class="h3" style="margin-top:14px">{k.title}</h3><p>{k.text}</p></div>)}
    </div>
  </div>
</section>

<section class="band" id="upcoming">
  <div class="wrap">
    <h2 class="h2">{T.upcoming}</h2>
    {j.upcoming.length
      ? <div class="trips">{j.upcoming.map(t => (
          <article class="trip">
            {t.image && <img src={t.image} alt="" loading="lazy" />}
            <div class="trip-body">
              <p class="mono">{[t.place, t.dates].filter(Boolean).join(' · ')}</p>
              <h3 class="h3">{t.title}</h3>
              <p>{t.text}</p>
              <p class="mono meta">{[t.spots, t.price].filter(Boolean).join(' · ')}</p>
              {t.apply_url && <a class="btn copal" href={t.apply_url}>{T.apply_button}</a>}
            </div>
          </article>))}</div>
      : <p class="italic">{T.upcoming_empty}</p>}
  </div>
</section>

{j.past.length > 0 && <section class="band noche">
  <div class="wrap">
    <h2 class="h2">{T.past}</h2>
    <div class="past">
      {j.past.map(p => (
        <figure class="place">
          {p.image && <img src={p.image} alt={p.caption || p.place} loading="lazy" />}
          <figcaption>
            <span class="h3">{p.place}</span>
            <span class="mono">{[p.year, p.caption].filter(Boolean).join(' · ')}</span>
            {p.audio && <audio controls preload="none" src={p.audio}></audio>}
          </figcaption>
        </figure>))}
    </div>
  </div>
</section>}

<section class="band cacao">
  <div class="wrap" style="text-align:center">
    <Divider />
    <h2 class="h2" style="margin-top:24px">{T.host}</h2>
    <p class="italic" style="margin:0 auto 28px">{T.host_text}</p>
    <a class="btn" href="./contact.html?reason=Journeys">Write to me</a>
  </div>
</section>

<style>
.kinds{max-width:900px;margin:0 auto}
.card-icon{width:84px;height:84px;object-fit:contain;display:block;margin:0 auto}
.trips{display:grid;gap:28px;max-width:900px;margin:0 auto}
.trip{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);border:1px solid var(--line);background:var(--cardbg);text-align:left}
.trip img{width:100%;height:100%;object-fit:cover;aspect-ratio:4/3}
.trip-body{padding:28px;display:flex;flex-direction:column;gap:10px;align-items:flex-start}
.trip-body .h3{margin:0}
.trip-body p{margin:0}
.trip-body .meta{color:var(--copal)}
.past{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.place{margin:0}
.place img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.place figcaption{padding:12px 0 0;display:flex;flex-direction:column;gap:4px;align-items:center}
.place .h3{font-size:22px}
.place audio{width:100%;margin-top:8px;filter:sepia(.4)}
@media (max-width:820px){.trip{grid-template-columns:1fr}.past{grid-template-columns:1fr 1fr}}
</style>
</Base>
