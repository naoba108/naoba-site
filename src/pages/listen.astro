---
import Base from '../layouts/Base.astro';
import Glyph from '../components/Glyph.astro';
import Video from '../components/Video.astro';
import Cochlea from '../components/Cochlea.astro';
import Spectrogram from '../components/Spectrogram.astro';
import listen from '../content/listen.json';
const glyphs = ['spiral', 'turtle', 'sun'];
import Gallery from '../components/Gallery.astro';
const learnShort = ((listen.learn_short||'').match(/(?:shorts\/|youtu\.be\/|v=|embed\/)([\w-]{11})/)||[])[1] || '';
const fieldBg = listen.field_background || '';
---
<Base title="Listen, NAOBA" page="listen">
<section class="page-hero">
  {listen.hero.video ? <video src={listen.hero.video} poster={listen.hero.poster} autoplay muted loop playsinline aria-hidden="true"></video> : <img src={listen.hero.poster} alt="" />}
  <div class="wrap">
    <p class="mono">{listen.hero.kicker}</p>
    <h1 class="h1">{listen.hero.title}</h1>
  </div>
</section>

<section class="band noche intro-band">
  <div class="wrap intro-grid">
    <div>
      <h2 class="h2">{listen.titles.intro}</h2>
      <div class="intro-text">{(listen.intro||'').split(/\n\s*\n/).map(par => <p>{par.trim()}</p>)}</div>
    </div>
    <Cochlea size={280} image={listen.figure.image} caption={listen.figure.caption} />
  </div>
</section>

<section class={`band field-bg ${fieldBg ? 'dark' : ''}`} style={fieldBg ? `--fbg:url(${fieldBg})` : undefined}>
  <div class="wrap">
    {listen.titles.field_kicker && <p class="mono center-text">{listen.titles.field_kicker}</p>}
    <h2 class="h2 center-text field-title">{listen.titles.field}</h2>
    {(listen.videos||[]).length > 0 && <div class="one-video" style="margin-bottom:40px">{(listen.videos||[]).slice(0,1).map(v => <Video id={v.youtube_id} title={v.title} />)}</div>}
  </div>
  {!fieldBg && <div class="wrap"><Gallery items={(listen.photos||[]).map(p=>({src:p.image,alt:p.alt||p.caption||'',caption:p.caption}))} /></div>}
  <div>
  </div>
</section>


{(listen.heard_on||[]).length > 0 && <section class="band noche heard-band" id="heard-on">
  <div class="wrap">
    <h2 class="h2 center-text">{listen.titles.heard_on || 'As heard on'}</h2>
    <div class="heard">
      {listen.heard_on.map(h => (
        <article class="heard-item">
          {h.image && <img class="heard-img" src={h.image} alt="" loading="lazy" />}
          {h.player && <iframe class="heard-player" src={h.player} title={`${h.outlet}: ${h.title}`} loading="lazy" frameborder="0" scrolling="no"></iframe>}
          <p class="mono">{[h.outlet, h.date].filter(Boolean).join(' · ')}</p>
          <h3 class="h3 heard-title">{h.title}</h3>
          {h.text && <p class="heard-text">{h.text}</p>}
          {h.link && <p><a class="btn outline" href={h.link} target="_blank" rel="noopener">{h.link_label || 'More'}</a></p>}
          {h.note && <p class="heard-note">{h.note}</p>}
        </article>))}
    </div>
  </div>
</section>}

{(listen.albums||[]).length > 0 && <section class="band albums-band">
  <div class="wrap">
    {listen.titles.albums && <h2 class="h2 center-text">{listen.titles.albums}</h2>}
    <div class="albums">
      {(listen.albums||[]).map(al => <div class="bc4w"><iframe class="bc4" src={`https://bandcamp.com/EmbeddedPlayer/album=${al.album_id}/size=large/bgcol=ffffff/linkcol=93702f/tracklist=false/transparent=true/`} title={`${al.title} on Bandcamp`} loading="lazy" seamless></iframe></div>)}
    </div>
    {listen.albums_link && <p class="center-text" style="margin-top:28px"><a class="btn solid" href={listen.albums_link}>{listen.titles.albums_button || 'More on Bandcamp'}</a></p>}
  </div>
</section>}

{listen.spectrogram.show && <section class={`band ${listen.spectrogram.image ? 'noche' : ''}`} style="padding-top:56px;padding-bottom:56px">
  <div class="wrap">{listen.spectrogram.image ? <figure style="margin:0;text-align:center"><img src={listen.spectrogram.image} alt={listen.spectrogram.label} loading="lazy" style="width:min(620px,100%);height:auto;display:block;margin:0 auto" /><figcaption class="mono" style="margin-top:8px">{listen.spectrogram.label}</figcaption></figure> : <Spectrogram label={listen.spectrogram.label} />}</div>
</section>}

<section class="band noche">
  <div class="wrap">
    <h2 class="h2">{listen.titles.research}</h2>
    <div class="grid3">
      {(listen.research||[]).map((r, i) => <div class="card plate">{r.icon ? <img class="card-icon" src={r.icon} alt="" width="84" height="84" loading="lazy" /> : <Glyph name={glyphs[i % 3]} />}<h3 class="h3" style="margin-top:14px">{r.title}</h3><p>{r.text}</p></div>)}
    </div>
  </div>
</section>

<section class="band closing">
  <div class="wrap grid2" style="align-items:center">
    {learnShort
      ? <div class="frame learn-short"><iframe src={`https://www.youtube-nocookie.com/embed/${learnShort}?rel=0&modestbranding=1&playsinline=1`} title={listen.titles.learn} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
      : <div class="frame"><img src={listen.learn_image} alt="" loading="lazy" style="width:100%;aspect-ratio:4/3;object-fit:cover" /></div>}
    <div class="closing-body">
      <div class="closing-part">
        <h2 class="h2">{listen.titles.sounds}</h2>
        <p class="italic">{listen.titles.sounds_text}</p>
        <p><a class="btn solid" href="./shop.html">Visit the shop</a></p>
      </div>
      <div class="closing-part">
        <h2 class="h2">{listen.titles.learn}</h2>
        <p class="italic">{listen.titles.learn_text}</p>
        <p><a class="btn" href="./mentorship.html">See mentorship</a></p>
      </div>
      {listen.titles.journeys_line && <p class="italic journeys-line"><a href="./journeys.html">{listen.titles.journeys_line}&nbsp;→</a></p>}
    </div>
  </div>
</section>

<style>
.field-bg{background:#0d0b08 var(--fbg) center 62%/cover no-repeat;position:relative}
.field-bg::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(13,11,8,.62) 0%,rgba(13,11,8,.38) 45%,rgba(13,11,8,.7) 100%)}
.field-bg > .wrap{position:relative;z-index:1}
.field-bg.dark .field-title{color:#F0C67C}

.intro-band{padding-top:64px !important;padding-bottom:64px !important}
.intro-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:48px;align-items:center}
.intro-grid .h2{margin-bottom:18px}
.intro-text p{font-family:var(--body);font-weight:300;font-style:normal;font-size:18px;line-height:1.9;letter-spacing:.012em;word-spacing:.06em;max-width:58ch;margin:0 auto 16px;color:rgba(246,239,224,.9)}
.intro-text p:last-child{margin-bottom:0}
.albums{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:36px}
.bc4w{position:relative;padding-bottom:calc(100% + 132px);background:#fff}
.bc4{position:absolute;inset:0;border:0;width:100%;height:100%;display:block}
.field-title{max-width:30ch;margin:0 auto 36px !important}
.learn-short{max-width:340px;margin:0 auto;aspect-ratio:9/16}
.closing-body{text-align:center}
.closing-part + .closing-part{margin-top:34px;padding-top:30px;border-top:1px solid var(--line)}
.closing .h2{font-size:clamp(30px,3.4vw,44px)}
.journeys-line{margin-top:26px}
.learn-short iframe{width:100%;height:100%;border:0;display:block}
@media (max-width:900px){.intro-grid{grid-template-columns:1fr;gap:28px}.albums{grid-template-columns:1fr 1fr}}

.plate{background-image:linear-gradient(#26402F 1px,transparent 1px),linear-gradient(90deg,#26402F 1px,transparent 1px);background-size:28px 28px;background-color:rgba(0,0,0,.35)}
.product{text-decoration:none;color:var(--maize);display:block;transition:border-color .4s}
.product:hover{border-color:var(--gold);color:var(--maize)}
.field-wide{margin:0;line-height:0}
.field-wide img{width:100%;max-height:78vh;object-fit:cover}
.card-icon{width:84px;height:84px;object-fit:contain;display:block;margin:0 auto}
.heard{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:36px;max-width:1000px;margin:40px auto 0;text-align:center}
.heard-item{border:1px solid rgba(240,198,124,.25);padding:26px;display:flex;flex-direction:column;align-items:center}
.heard-player{width:100%;height:224px;border:0;background:#222;display:block;margin:-22px 0 22px}
.heard-img{width:100%;height:290px;object-fit:cover;display:block;margin-bottom:22px}
.heard-title{margin:8px 0 10px;font-size:clamp(20px,2vw,24px);line-height:1.3}
.heard-note{margin:12px 0 0;font-size:14px;font-style:italic;opacity:.7}
.heard-text{opacity:.85;margin:0 0 18px}
</style>
</Base>
