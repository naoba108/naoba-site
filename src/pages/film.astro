---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import Glyph from '../components/Glyph.astro';
import Video from '../components/Video.astro';
import film from '../content/film.json';
import site from '../content/site.json';
const glyphs = ['spiral', 'turtle', 'double', 'sun'];
const types = ['Documentary', 'Feature film', 'Short film', 'Animation', 'Series', 'Installation', 'Something else'];
const budgets = ['Under 1,000', '1,000 to 3,000', '3,000 to 8,000', 'Over 8,000', 'Not sure yet'];
---
<Base title="Film and soundtrack, NAOBA" page="film">
<section class="page-hero">
  <img src="./images/tree-bw.jpg" alt="Tamara Montenegro listening to a tree" />
  <div class="wrap">
    <p class="mono">Composer and sound designer</p>
    <h1 class="h1">Film &amp; soundtrack</h1>
  </div>
</section>

<section class="band">
  <div class="wrap grid2">
    <p class="italic" style="margin:0">{film.intro}</p>
    <Video id={film.showreel_id} title="Showreel" />
  </div>
</section>

<section class="band noche">
  <div class="wrap">
    <h2 class="h2">What I make</h2>
    <div class="grid4">
      {film.services.map((s, i) => <div class="card"><Glyph name={glyphs[i % 4]} /><h3 class="h3" style="margin-top:14px">{s.title}</h3><p>{s.text}</p></div>)}
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <h2 class="h2">Projects</h2>
    <ol class="projects">
      {film.projects.map(p => (
        <li>
          <span class="mono yr">{p.year}</span>
          <span><span class="h3 t">{p.title}</span><br /><span class="small">{p.role}</span></span>
          <span class="mono note">{p.note}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="band cacao" id="quote">
  <div class="wrap grid2" style="align-items:start">
    <div>
      <Divider />
      <h2 class="h2" style="margin-top:24px">Tell me about your project</h2>
      <p class="italic">Share a few details and I'll write back with ideas, a timeline and a quote.</p>
    </div>
    <form class="form" id="quote-form">
      <label>Your name<input name="name" required autocomplete="name" /></label>
      <label>Your email<input name="email" type="email" required autocomplete="email" /></label>
      <label>Type of project<select name="type">{types.map(t => <option>{t}</option>)}</select></label>
      <label>Length (minutes)<input name="length" inputmode="numeric" /></label>
      <label>Deadline<input name="deadline" /></label>
      <label>Budget range (USD or EUR)<select name="budget">{budgets.map(b => <option>{b}</option>)}</select></label>
      <label>About the project<textarea name="about" rows="5" required></textarea></label>
      <button class="btn solid" type="submit">Request a quote</button>
      <p class="small" id="quote-note" role="status"></p>
    </form>
  </div>
</section>

<script is:inline define:vars={{ email: site.email }}>
document.getElementById('quote-form').addEventListener('submit', function (e) {
  e.preventDefault();
  const f = new FormData(this);
  const body = ['name','email','type','length','deadline','budget'].map(k => `${k}: ${f.get(k)}`).join('\n') + `\n\n${f.get('about')}`;
  location.href = `mailto:${email}?subject=${encodeURIComponent('Film project: ' + f.get('type'))}&body=${encodeURIComponent(body)}`;
  document.getElementById('quote-note').textContent = `Your email app should open now. If it doesn't, write to ${email}.`;
});
</script>

<style>
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.projects{list-style:none;padding:0;margin:0}
.projects li{display:grid;grid-template-columns:110px 1fr minmax(0,320px);gap:22px;align-items:baseline;padding:20px 0;border-top:1px solid var(--line)}
.projects .t{margin:0}
.projects .note{text-align:right;color:var(--copal)}
.form{display:grid;gap:16px}
.form label{display:grid;gap:6px;font-family:var(--head);font-size:18px;color:var(--lgold)}
.form input,.form select,.form textarea{font:300 16px var(--body);color:var(--maize);background:var(--obsidian);border:1px solid var(--moss);border-radius:2px;padding:12px 14px}
.form input:focus,.form select:focus,.form textarea:focus{outline:none;border-color:var(--gold)}
.form button{justify-self:start}
@media (max-width:820px){.grid4{grid-template-columns:1fr 1fr}.projects li{grid-template-columns:1fr}.projects .note{text-align:left}}
</style>
</Base>
