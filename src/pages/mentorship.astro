---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import Glyph from '../components/Glyph.astro';
import Video from '../components/Video.astro';
import m from '../content/mentorship.json';
import site from '../content/site.json';
const G = m.guide || {};
const showPrices = G.show_prices !== false && !G.file ? true : !!G.show_prices;
const sub = (site.substack || '').replace(/\/$/, '');
const glyphs = ['spiral', 'turtle', 'sun'];
import Gallery from '../components/Gallery.astro';
---
<Base title="Mentorship, NAOBA" page="mentorship">
<section class="page-hero">
  <img src={m.hero.image} alt="" />
  <div class="wrap">
    <p class="mono">{m.hero.kicker}</p>
    <h1 class="h1">{m.hero.title}</h1>
  </div>
</section>

<section class="band">
  <div class="wrap grid2">
    <p class="italic" style="margin:0">{m.intro}</p>
    <Video id={m.video_id} title={m.titles.video} />
  </div>
</section>

<section class="band" style="padding-top:0">
  <div class="wrap">
    <Gallery items={(m.photos||[]).map(p=>({src:p.image,alt:p.alt||p.caption||'',caption:p.caption}))} />
  </div>
</section>

<section class="band noche">
  <div class="wrap">
    <Divider />
    <h2 class="h2" style="text-align:center;margin-top:28px">{m.titles.paths}</h2>
    <p class="lede" style="text-align:center;margin:0 auto 44px">{m.titles.paths_lede}</p>
    <div class="grid3">
      {(m.packages||[]).map((p, i) => (
        <article class={`card pkg ${i === 2 ? 'feature' : ''}`}>
          <Glyph name={glyphs[i]} size={40} color={i === 2 ? 'var(--copal)' : 'var(--gold)'} />
          <h3 class="h1" style="font-size:44px;margin-top:12px">{p.name}</h3>
          <p class="italic" style="font-size:18px;margin:2px 0 14px">{p.meaning}, {p.length}</p>
          {showPrices && <p class="price">{p.usd} <span>/ {p.eur}</span></p>}
          {showPrices && p.plan && <p class="mono">{p.plan}</p>}
          <p class="mono" style="color:var(--maize);margin-top:10px">{p.sessions}, every 2 weeks</p>
          <ul>{p.includes.map(x => <li>{x}</li>)}</ul>
          <a class={`btn ${i === 2 ? 'solid' : ''}`} href="./contact.html">Book a free call</a>
        </article>
      ))}
    </div>
    {G.file && !showPrices && (
      <div class="guide" id="guide">
        <p class="g-from">{G.from}</p>
        <h3 class="h2 g-title">{G.title}</h3>
        <p class="g-text">{G.text}</p>
        <form class="g-form" action={`${sub}/api/v1/free?nojs=true`} method="post" target="g-sink">
          <label class="sr" for="g-email">Your email</label>
          <input id="g-email" type="email" name="email" placeholder="Your email" required autocomplete="email" />
          <input type="hidden" name="first_url" value="https://naobasounds.com/mentorship.html" />
          <button class="btn solid" type="submit">{G.button}</button>
        </form>
        <div class="g-done" hidden>
          <p>{G.done}</p>
          <a class="btn" href={G.file} target="_blank" rel="noopener" download>Download the guide</a>
        </div>
        <iframe name="g-sink" title="" aria-hidden="true" tabindex="-1" style="display:none"></iframe>
      </div>
    )}
    <script is:inline>
    (function(){var f=document.querySelector('.g-form');if(!f)return;f.addEventListener('submit',function(){var d=document.querySelector('.g-done'),a=d.querySelector('a');window.open(a.href,'_blank');setTimeout(function(){f.hidden=true;d.hidden=false;},300);});})();
    </script>
  </div>
</section>

{(m.testimonials||[]).some(t => t.quote) && <section class="band testimonials">
  <div class="wrap">
    <h2 class="h2">{m.titles?.testimonials || 'Words from artists'}</h2>
    <div class="grid3">
      {(m.testimonials||[]).filter(t => t.quote).map(t => (
        <figure class={`card tq ${t.quote ? '' : 'empty'}`}>
          {t.photo ? <img class="tq-photo" src={t.photo} alt={t.name || ''} loading="lazy" /> : <div class="tq-photo ph" aria-hidden="true"></div>}
          <blockquote>{t.quote || 'Testimonial coming soon.'}</blockquote>
          <figcaption><span class="tq-name">{t.name || 'Artist name'}</span>{(t.role || !t.quote) && <span class="mono">{t.role || 'Mentorship path'}</span>}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>}

{m.cal?.link && <section class="band cal-band" id="book">
  <div class="wrap">
    {m.cal.kicker && <p class="mono">{m.cal.kicker}</p>}
    <h2 class="h2">{m.cal.title}</h2>
    {m.cal.text && <p class="italic" style="max-width:52ch;margin:0 auto 34px">{m.cal.text}</p>}
    <div id="cal-inline" class="cal-inline" data-cal-link={m.cal.link}></div>
    <noscript><p><a class="btn solid" href={`https://cal.com/${m.cal.link}`}>Book on Cal.com</a></p></noscript>
  </div>
</section>}


<style>
.pkg{display:flex;flex-direction:column}
.pkg ul{list-style:none;padding:0;margin:18px 0 24px;flex:1}
.pkg li{padding:8px 0 8px 18px;border-top:1px solid var(--line);position:relative;font-size:16px}
.pkg li::before{content:'';position:absolute;left:0;top:17px;width:6px;height:6px;border:1px solid var(--gold);transform:rotate(45deg)}
.pkg .btn{align-self:center}
.guide{max-width:720px;margin:56px auto 0;text-align:center;border:1px solid var(--gold);padding:40px 36px}
.g-from{font-family:var(--sans);font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);margin:0 0 10px}
.g-title{margin:0 0 12px;font-size:clamp(30px,3.2vw,42px) !important}
.g-text{margin:0 auto 24px;max-width:52ch;opacity:.9}
.g-form{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.g-form input{flex:1 1 260px;max-width:340px;padding:14px 16px;background:transparent;border:1px solid var(--gold);color:var(--maize);font:inherit}
.g-form input::placeholder{color:var(--maize);opacity:.6}
.g-done p{margin:0 0 18px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.tq{margin:0;display:flex;flex-direction:column;align-items:center;gap:16px}
.tq-photo{width:84px;height:84px;border-radius:50%;object-fit:cover;border:1px solid var(--gold)}
.tq-photo.ph{background:var(--obsidian)}
.tq blockquote{margin:0;font-family:var(--fell);font-size:18px;line-height:1.55;font-style:italic}
.tq.empty blockquote{opacity:.55}
.tq figcaption{display:flex;flex-direction:column;gap:4px}
.tq-name{font-family:var(--title);font-size:22px;color:var(--lgold)}
.price{font-family:var(--body);font-weight:450;font-variant-numeric:lining-nums;font-size:30px;color:var(--lgold);margin:0}
.price span{font-size:22px;color:var(--gold)}
.feature{border-color:var(--copal)}
.mix-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:32px 0 24px}
.mix{display:flex;flex-direction:column}
.mix .price{font-size:28px;margin-top:8px}
.mix-detail{font-size:15px;line-height:1.5;margin:12px 0 0}
.mix-note{margin:0 0 24px}
@media (max-width:980px){.mix-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:560px){.mix-grid{grid-template-columns:1fr}}
</style>
<style>
.cal-inline{width:100%;min-height:640px;max-width:1040px;margin:0 auto;background:#fff;border:1px solid var(--line)}
</style>
<script is:inline>
(function(){var el=document.getElementById('cal-inline');if(!el)return;var link=el.dataset.calLink;
(function (C, A, L) { var p = function (a, ar) { a.q.push(ar); }; var d = C.document; C.Cal = C.Cal || function () { var cal = C.Cal; var ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { var api = function () { p(api, arguments); }; var namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
Cal("init", "naoba", {origin:"https://cal.com"});
Cal.ns.naoba("inline", {elementOrSelector:"#cal-inline", config:{layout:"month_view", theme:"light"}, calLink: link});
Cal.ns.naoba("ui", {theme:"light", cssVarsPerTheme:{light:{"cal-brand":"#93702F"}}, hideEventTypeDetails:false, layout:"month_view"});
})();
</script>
</Base>
