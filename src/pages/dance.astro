---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import Glyph from '../components/Glyph.astro';
import Video from '../components/Video.astro';
import site from '../content/site.json';
import dance from '../content/dance.json';
const sc = `https://w.soundcloud.com/player/?url=${encodeURIComponent(dance.soundcloud_track)}&color=%23e8822a&auto_play=false&hide_related=true&show_comments=false&visual=true`;
const glyphs = ['spiral', 'double', 'temple'];
import Gallery from '../components/Gallery.astro';
---
<Base title="Dance, NAOBA" page="dance">
<section class="page-hero">
  <img src={dance.hero.image} alt={dance.hero.title} />
  <div class="wrap">
    <p class="mono" style="color:var(--copal)">{dance.hero.kicker}</p>
    <h1 class="h1">{dance.hero.title}</h1>
  </div>
</section>

<section class="band cacao">
  <div class="wrap grid2">
    <p class="italic" style="margin:0">{dance.intro}</p>
    <div class="frame"><iframe class="player" src={sc} title="NAOBA mixes on SoundCloud" loading="lazy"></iframe></div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <h2 class="h2">{dance.titles.offerings}</h2>
    <div class="grid3">
      {(dance.offerings||[]).map((o, i) => <div class={`card ${o.image ? 'photo-card' : ''}`} style={o.image ? `--bg:url(${o.image});--pos:${o.focus || "center"}` : undefined}><div class="pc-inner"><Glyph name={glyphs[i % 3]} color={o.image ? "#F0C67C" : "var(--copal)"} /><h3 class="h3" style="margin-top:14px">{o.title}</h3><p>{o.text}</p></div></div>)}
    </div>
  </div>
</section>

<section class="collage dark">
  <div class="wrap"><Gallery items={(dance.photos||[]).map(p=>({src:p.image,alt:p.alt||p.caption||'',caption:p.caption}))} /></div>
</section>
<section class="band cacao">
  <div class="wrap">
    <h2 class="h2">{dance.titles.watch}</h2>
    <div class="one-video">{(dance.videos||[]).slice(0,1).map(v => <Video id={v.youtube_id} title={v.title} />)}</div>
  </div>
</section>

{dance.cacao_video?.video && <section class="band noche cacao-film">
  <div class="wrap">
    <figure class="one-video">
      <video src={dance.cacao_video.video} poster={dance.cacao_video.poster} controls playsinline preload="metadata"></video>
      {dance.cacao_video.caption && <figcaption class="mono">{dance.cacao_video.caption}</figcaption>}
    </figure>
  </div>
</section>}

<section class="band">
  <div class="wrap grid2" style="align-items:start">
    <div>
      <h2 class="h2">{dance.titles.events}</h2>
      {(dance.events||[]).length
        ? <ul class="list">{(dance.events||[]).map(e => <li><span>{e.city}, {e.venue}</span><a class="mono" href={e.tickets}>{e.date}</a></li>)}</ul>
        : <p class="italic">{dance.titles.events_empty}</p>}
      <p><a class="btn copal" href="./contact.html">Host a CACAO Bass gathering</a></p>
    </div>
    <div>
      <h3 class="h3">{dance.titles.stages}</h3>
      <ul class="list">{(dance.stages||[]).map(s => <li><span>{s}</span></li>)}</ul>
    </div>
  </div>
</section>

<section class="band cacao">
  <div class="wrap grid2">
    <img class="photo" src={dance.book_image} alt="" loading="lazy" />
    <div>
      <Divider />
      <h2 class="h2" style="margin-top:24px">{dance.titles.book}</h2>
      <p class="italic">{dance.titles.book_text}</p>
      <p><a class="btn solid" href="./contact.html">Send a booking request</a></p>
      {dance.titles.journeys_line && <p class="italic" style="margin-top:22px"><a href="./journeys.html">{dance.titles.journeys_line} →</a></p>}
    </div>
  </div>
</section>

<style>
.player{width:100%;height:300px;border:0;display:block;background:#000}
.photo{width:100%;aspect-ratio:4/5;object-fit:cover;filter:brightness(.85)}
.collage{background:#000;line-height:0}
.collage img{width:100%;height:auto;max-height:520px;object-fit:cover}
</style>

<style>
.photo-card{position:relative;overflow:hidden;min-height:340px;display:flex;align-items:flex-end;justify-content:center;border:0;background:#1a1510 var(--bg) var(--pos,center)/cover no-repeat;color:#F6EFE0}
.photo-card::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,16,10,.25) 0%,rgba(20,16,10,.55) 45%,rgba(20,16,10,.88) 100%)}
.photo-card .pc-inner{position:relative;z-index:1;padding:28px 22px 26px}
.photo-card .h3{color:#F6EFE0}
.photo-card p{color:rgba(246,239,224,.88)}
.cacao-film figure{margin:0 auto}
.cacao-film video{width:100%;display:block;background:#000}
.cacao-film figcaption{margin-top:12px;text-align:center;color:var(--lgold)}
</style>
</Base>
