---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import Glyph from '../components/Glyph.astro';
import Video from '../components/Video.astro';
import site from '../content/site.json';
import awards from '../content/awards.json';
import dance from '../content/dance.json';
import listen from '../content/listen.json';
import music from '../content/music.json';
import press from '../content/press.json';
import Player from '../components/Player.astro';
const homeVideos = [dance.videos[0], listen.videos[0]];
---
<Base title="NAOBA, Tamara Montenegro" page="home">
<section class="hero">
  <video src="./video/tree.mp4" poster="./images/tree-poster.jpg" autoplay muted loop playsinline aria-hidden="true"></video>
  <div class="shade"></div>
  <div class="center">
    <img class="logo" src="./images/logo.webp" alt="NAOBA" width="1200" height="543" />
    <p class="italic tag">{site.tagline_1}<br />{site.tagline_2}{site.tagline_3 && <><br />{site.tagline_3}</>}</p>
  </div>
  <a class="cue" href="#doors">Enter</a>
</section>

<div class="portal" id="doors">
<section class="doors">
  <a class="door dance" href="./dance.html">
    <img src="./images/dj-candles.jpg" alt="NAOBA DJing by candlelight" loading="lazy" />
    <div class="txt"><h2 class="h1">Dance</h2><p class="italic">Ecstatic Dance &amp; Cacao Bass<sup class="tm">™</sup> Gatherings</p><span class="btn copal">Book NAOBA</span></div>
  </a>
  <a class="door listen" href="./listen.html">
    <video src="./video/grass.mp4" poster="./images/ometepe-jungle.jpg" autoplay muted loop playsinline aria-hidden="true"></video>
    <div class="txt"><h2 class="h1">Listen</h2><p class="italic">Heart in Nature. Nervous System &amp; Immersive Listening.</p><span class="btn">Enter the lab</span></div>
  </a>
</section>

<section class="small-doors">
  <a class="sdoor" href="./film.html"><img src="./images/tree-bw.jpg" alt="" loading="lazy" /><span class="h2">Film</span><span class="italic">Scores and sound design</span></a>
  <a class="sdoor" href="./shop.html"><img src="./images/guitar-hand.jpg" alt="" loading="lazy" /><span class="h2">Download</span><span class="italic">Sound Design Tools, Sample Packs &amp; Ableton Templates</span></a>
  <a class="sdoor" href="./mentorship.html"><img src="./images/studio-circle.jpg" alt="" loading="lazy" /><span class="h2">Mentorship</span><span class="italic">Three paths</span></a>
</section>
<a class="listen-strip" href="#music" aria-label="Keep scrolling to listen to NAOBA">
  <span class="wave" aria-hidden="true">{Array.from({length:28}).map((_, i) => <i style={`--d:${(i*0.137)%1.1}s;--h:${30+((i*37)%60)}%`}></i>)}</span>
  <span class="strip-text">Keep scrolling to listen</span>
  <span class="arrow" aria-hidden="true">↓</span>
</a>
</div>

<section class="band">
  <div class="wrap center-text">
    <Glyph name="spiral" size={48} />
    <p class="italic intro">{site.intro}</p>
  </div>
</section>

<section class="band noche" id="music">
  <div class="wrap">
    <h2 class="h2">Music</h2>
    <p class="lede">{music.intro} Released on {awards.labels.slice(0, 6).join(', ')} and more.</p>
    <div class="players">
      {music.players.map(pl => <Player url={pl.url} title={pl.title} size={pl.size} />)}
    </div>
    <p style="margin-top:28px"><a class="btn" href={site.bandcamp}>Buy on Bandcamp</a></p>
  </div>
</section>

<section class="band cacao" id="gigs">
  <div class="wrap grid2" style="align-items:start">
    <div>
      <h2 class="h2">Next gigs</h2>
      {dance.events.length
        ? <ul class="list gigs">{dance.events.map(e => <li><span><strong>{e.date}</strong><br />{e.city}, {e.venue}</span>{e.tickets ? <a class="btn" href={e.tickets}>Tickets</a> : null}</li>)}</ul>
        : <p class="lede">New dates are on their way. They're announced first in the letters, at the bottom of this page.</p>}
    </div>
    <div class="book-box">
      <h3 class="h3">Bring NAOBA to your event</h3>
      <p>Ecstatic dance, festivals, CACAO Bass gatherings and immersive listening sessions.</p>
      <p><a class="btn copal" href="./dance.html">Book NAOBA</a> <a class="btn" href="#press">Press kit</a></p>
    </div>
  </div>
</section>

<section class="band" id="videos">
  <div class="wrap">
    <h2 class="h2">Videos</h2>
    <div class="grid2">
      {homeVideos.map(v => <Video id={v.youtube_id} title={v.title} />)}
    </div>
    <p style="margin-top:28px"><a class="btn" href={site.youtube}>More on YouTube</a></p>
  </div>
</section>

<section class="band cacao" id="awards">
  <div class="wrap">
    <Divider />
    <div class="center-text" style="margin:40px 0 56px">
      <Glyph name="sun" size={56} color="var(--lgold)" />
      <p class="mono" style="margin:14px 0 6px">{awards.highlight.title}</p>
      <h2 class="h1">{awards.highlight.detail}</h2>
    </div>
    <div class="grid2" style="align-items:start">
      <div>
        <h3 class="h3">Music awards</h3>
        <ul class="list">
          {awards.awards.map(a => <li><span>{a.prize}</span><span class="mono">{a.org}</span></li>)}
        </ul>
      </div>
      <div>
        <h3 class="h3">Film</h3>
        <ul class="list">
          {awards.film.map(a => <li><span>{a.prize}<br /><span class="small" style="color:var(--gold)">{a.for}</span></span><span class="mono">{a.org}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="band noche" id="press">
  <div class="wrap">
    <h2 class="h2">Press kit</h2>
    <p class="lede">For promoters and event organisers: bio, photos and links, ready to use.</p>
    <div class="grid2" style="align-items:start">
      <div>
        <h3 class="h3">Short bio</h3>
        <p>{press.bio_short}</p>
        <p class="press-btns">
          <a class="btn copal" href="./press/naoba-press-photos.zip" download>Download all photos (.zip)</a>
          {press.epk_pdf && <a class="btn" href={press.epk_pdf}>EPK (PDF)</a>}
          {press.rider_pdf && <a class="btn" href={press.rider_pdf}>Tech rider (PDF)</a>}
        </p>
      </div>
      <div class="photo-grid">
        {press.photos.map(ph => (
          <a class="press-photo" href={`./press/${ph.file}.jpg`} download>
            <img src={`./press/${ph.file}-thumb.webp`} alt={ph.title} loading="lazy" />
            <span>{ph.title}{ph.credit && ` · Photo: ${ph.credit}`}<br /><em>Download high-res</em></span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.hero{position:relative;height:100vh;min-height:560px;overflow:hidden;display:grid;place-items:center}
.hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.shade{position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(0,0,0,.25) 0%,rgba(0,0,0,.72) 70%,#000 100%)}
.center{position:relative;z-index:2;text-align:center;padding:0 20px}
.logo{width:min(560px,82vw);height:auto;margin:0 auto;opacity:0;animation:rise 2.4s 1s ease forwards}
.italic.tag{font-family:'IM Fell English',Georgia,serif;font-style:italic;font-size:clamp(19px,2vw,23px);line-height:1.45}
.tag{margin:18px auto 0;text-align:center;opacity:0;animation:rise 2s 2.4s ease forwards}
.cue{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:2;font-family:var(--head);font-size:18px;text-decoration:none}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.logo,.tag{animation:none;opacity:1}}
.portal{height:calc(100vh - var(--navh));height:calc(100svh - var(--navh));min-height:560px;display:grid;grid-template-rows:3fr 2fr auto}
.doors{display:grid;grid-template-columns:1fr 1fr;min-height:0}
.door{position:relative;overflow:hidden;display:flex;align-items:flex-end;padding:clamp(22px,3.2vw,44px);min-height:0;text-decoration:none;border-top:1px solid var(--line)}
.door + .door{border-left:1px solid var(--line)}
.door img,.door video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.2s ease,filter 1.2s ease;filter:brightness(.55)}
.door:hover img,.door:hover video{transform:scale(1.04);filter:brightness(.72)}
.door::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.85),transparent 60%)}
.door .txt{position:relative;z-index:2}
.door .italic{margin:8px 0 14px;max-width:34ch}
.door .h1{font-size:clamp(38px,5.2vw,72px)}
.center-text{text-align:center}
.center-text .italic,.intro{margin:20px auto 0;max-width:44ch;text-align:center}
.players{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 28px}
@media (max-width:820px){.players{grid-template-columns:1fr}}
.small-doors{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}
.sdoor{position:relative;min-height:0;display:flex;flex-direction:column;justify-content:flex-end;padding:30px;text-decoration:none;overflow:hidden;border-right:1px solid var(--line)}
.sdoor:last-child{border-right:0}
.sdoor img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.42);transition:transform 1.2s ease,filter 1.2s ease}
.sdoor:hover img{transform:scale(1.04);filter:brightness(.6)}
.sdoor .h2,.sdoor .italic{position:relative;z-index:2;margin:0}
.sdoor .italic{font-size:18px}
@media (max-width:820px){.portal{grid-template-rows:2fr 1fr}.doors{grid-template-columns:1fr;grid-template-rows:1fr 1fr}.door + .door{border-left:0}.door{padding:20px}.door .italic{font-size:15px;margin:4px 0 10px}.door .btn{font-size:15px;padding:7px 14px}.sdoor{padding:14px}.sdoor .h2{font-size:20px}.sdoor .italic{display:none}}
.listen-strip{display:flex;align-items:center;justify-content:center;gap:18px;padding:12px 20px;background:var(--obsidian);border-top:1px solid var(--line);text-decoration:none;color:var(--lgold)}
.listen-strip:hover .strip-text{color:var(--copal)}
.wave{display:flex;align-items:center;gap:3px;height:26px}
.wave i{display:block;width:3px;height:var(--h);background:var(--gold);border-radius:2px;transform-origin:center}
.strip-text{font-family:var(--head);font-size:19px;letter-spacing:.03em}
.arrow{font-size:20px}
@media (prefers-reduced-motion:no-preference){.wave i{animation:pulse 1.1s ease-in-out var(--d) infinite alternate}.arrow{animation:nudge 1.6s ease-in-out infinite}}
@keyframes pulse{from{transform:scaleY(.35)}to{transform:scaleY(1)}}
@keyframes nudge{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
.gigs li{align-items:center}
.book-box{border:1px solid var(--moss);padding:28px}
.press-btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.press-photo{position:relative;display:block;aspect-ratio:1;overflow:hidden;text-decoration:none;border:1px solid var(--line)}
.press-photo img{width:100%;height:100%;object-fit:cover;transition:filter .4s}
.press-photo span{position:absolute;left:0;right:0;bottom:0;padding:8px 10px;font-size:13px;line-height:1.35;color:var(--maize);background:linear-gradient(to top,rgba(0,0,0,.85),transparent)}
.press-photo em{color:var(--lgold);font-style:normal}
.press-photo:hover img{filter:brightness(.7)}
@media (max-width:820px){.photo-grid{grid-template-columns:repeat(2,1fr)}.wave{display:none}.strip-text{font-size:16px}}
.tm{font-size:.55em;vertical-align:super;line-height:0;margin-left:1px}
</style>
<script is:inline>
(function(){
  function go(e){var d=document.getElementById('doors'); if(!d) return; if(e) e.preventDefault(); d.scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block:'start'}); history.replaceState(null,'','#doors');}
  var cue=document.querySelector('.cue'); if(cue) cue.addEventListener('click',go);
  document.addEventListener('keydown',function(e){
    var t=document.activeElement; var typing=t&&(/INPUT|TEXTAREA|SELECT/.test(t.tagName)||t.isContentEditable);
    if(e.key==='Enter'&&!typing&&(!t||t===document.body||t===cue)&&window.scrollY<window.innerHeight*0.6){go(e);}
  });
})();
</script>
</Base>
