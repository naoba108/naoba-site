---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import Glyph from '../components/Glyph.astro';
import Video from '../components/Video.astro';
import site from '../content/site.json';
import awards from '../content/awards.json';
import dance from '../content/dance.json';
import listen from '../content/listen.json';
import music from '../content/music.json';
import press from '../content/press.json';
import shorts from '../content/shorts.json';
const shortId = (u) => { const m = (u||'').match(/(?:shorts\/|youtu\.be\/|v=|embed\/)([A-Za-z0-9_-]{11})/); return m ? m[1] : ''; };
const shortList = shorts.items.map(it => ({...it, id: shortId(it.url)}));
const photos = press.photos.map(ph => ph.image ? { title: ph.title, href: ph.image, thumb: ph.image } : { title: ph.title, href: `./press/${ph.file}.jpg`, thumb: `./press/${ph.file}-thumb.webp` });
const photoSlots = [...photos, ...Array(Math.max(0, 9 - photos.length)).fill(null)];
import Player from '../components/Player.astro';
import Signup from '../components/Signup.astro';
import Cymatic from '../components/Cymatic.astro';
import gigs from '../content/gigs.json';
import home from '../content/home.json';
const T = home.titles; const D = home.doors; const reel = home.reel;
const homeVideos = [dance.videos[0], listen.videos[0]];
---
<Base title="NAOBA, Tamara Montenegro" page="home">
<section class="hero dark">
  <video src={home.hero.video} poster={home.hero.poster} autoplay muted loop playsinline aria-hidden="true"></video>
  <div class="shade"></div>
  <div class="center">
    <img class="logo" src="./images/logo.webp" alt="NAOBA" width="1200" height="543" />
    <p class="italic tag">{site.tagline_1}<br />{site.tagline_2}{site.tagline_3 && <><br />{site.tagline_3}</>}</p>
    <a class="cue btn" href="#doors">{home.hero.button}</a>
  </div>
</section>

<div class="portal dark" id="doors">
<section class="doors">
  <a class="door dance" href="./dance.html">
    <img src={D.dance.image} alt={D.dance.title} loading="lazy" />
    <div class="txt"><h2 class="h1">{D.dance.title}</h2><p class="italic" set:html={D.dance.subtitle.replace("™","<sup class='tm'>™</sup>")}></p><span class="btn copal">{D.dance.button}</span></div>
  </a>
  <a class="door listen" href="./listen.html">
    {D.listen.video ? <video src={D.listen.video} poster={D.listen.poster} autoplay muted loop playsinline aria-hidden="true"></video> : <img src={D.listen.poster} alt={D.listen.title} loading="lazy" />}
    <div class="txt"><h2 class="h1">{D.listen.title}</h2><p class="italic">{D.listen.subtitle}</p><span class="btn">{D.listen.button}</span></div>
  </a>
</section>

<section class="small-doors">
  {[["journeys",D.journeys],["film",D.film],["shop",D.shop],["mentorship",D.mentorship]].filter(([k,d])=>d).map(([k,d]) => <a class="sdoor" href={`./${k}.html`}><img src={d.image} alt="" loading="lazy" /><span class="h2">{d.title}</span><span class="italic">{d.subtitle}</span></a>)}
</section>
<a class="listen-strip" href="#music" aria-label="Keep scrolling to listen to NAOBA">
  <span class="wave" aria-hidden="true">{Array.from({length:28}).map((_, i) => <i style={`--d:${(i*0.137)%1.1}s;--h:${30+((i*37)%60)}%`}></i>)}</span>
  <span class="strip-text">{home.strip_text}</span>
  <span class="arrow" aria-hidden="true">↓</span>
</a>
</div>

<section class="tribe" id="tribe">
  <Signup />
</section>

<div class="marquee" aria-hidden="true"><div class="track">{Array.from({length:6}).flatMap(() => home.marquee).map(w => <><span>{w}</span><i>✦</i> </>)}</div></div>

<section class="reel-band" id="live" aria-label="NAOBA live">
  <div class="reel">
    <video data-src={reel.video} poster={reel.poster} muted loop={reel.loop} playsinline preload="none" data-autoplay={reel.autoplay ? "1" : "0"} aria-label="NAOBA live performances"></video>
    {reel.sound_button && <button class="sound-btn" type="button" data-on={reel.sound_label} data-off={reel.mute_label} aria-pressed="false">{reel.sound_label}</button>}
  </div>
</section>

<section class="band" id="music">
  <div class="wrap">
    <h2 class="h2 center-text" style="margin-bottom:40px">{T.music}</h2>
    <div class="players">
      {music.players.map(pl => <Player url={pl.url} title={pl.title} size={pl.size} />)}
    </div>
    <div class="healing">
      <Cymatic size={150} petals={8} color="var(--gold)" />
      <h3 class="h3">{music.healing_title}</h3>
      <p>{music.healing_text}</p>
    </div>
    {music.bandcamp_albums?.length > 0 && (
      <div class="bc-albums">
        {music.bandcamp_albums.map(al => (
          <iframe class="bc" src={`https://bandcamp.com/EmbeddedPlayer/album=${al.album_id}/size=large/bgcol=ffffff/linkcol=93702f/tracklist=false/transparent=true/`} title={`${al.title} on Bandcamp`} loading="lazy" seamless></iframe>
        ))}
      </div>
    )}
    <p class="center-text" style="margin-top:36px"><a class="btn" href={site.bandcamp}>{T.bandcamp_button}</a></p>
  </div>
</section>

<section class="band noche geo-bg" id="gigs">
  <div class="geo-mark" aria-hidden="true"><Cymatic size={560} petals={5} color="#E6C37F" opacity={0.12} /></div>
  <div class="wrap">
    <h2 class="h2 center-text">{T.gigs}</h2>
    {gigs.bandsintown_artist
      ? <div class="bit-wrap"><a class="bit-widget-initializer" data-artist-name={gigs.bandsintown_artist} data-app-id={gigs.bandsintown_app_id || undefined} data-display-local-dates="false" data-display-past-dates="false" data-auto-style="false" data-text-color="#EFE3C8" data-link-color="#BC9855" data-background-color="rgba(0,0,0,0)" data-display-limit="8" data-link-text-color="#FFFFFF" data-popup-background-color="#0F2619" data-separator-color="rgba(240,198,124,0.2)" data-font="Jost" data-display-track-button="true" data-display-play-my-city="true"></a></div>
      : <p class="lede center-text" style="margin:0 auto 28px">{T.gigs_empty}</p>}
    <p class="center-text"><a class="btn copal" href="./dance.html">Book NAOBA</a></p>
  </div>
</section>



<section class="band noche press" id="press">
  <div class="wrap center-text">
    <Cymatic size={110} petals={6} color="#E6C37F" />
    <p class="mono" style="margin-top:18px">{T.press_kicker}</p>
    <h2 class="h2">{T.press}</h2>
    <p class="press-bio" style="white-space:pre-line">{press.bio_short}</p>
    <p class="press-btns">
      <a class="btn copal" href="./press/naoba-press-photos.zip" download>Download all photos (.zip)</a>
      {press.epk_pdf && <a class="btn" href={press.epk_pdf}>EPK (PDF)</a>}
      {press.rider_pdf && <a class="btn" href={press.rider_pdf}>Tech rider (PDF)</a>}
    </p>

    <h3 class="h3 sub">{T.photos}</h3>
    <div class="arches">
      {photoSlots.map(ph => ph
        ? <a class="arch" href={ph.href} download><img src={ph.thumb} alt={ph.title} loading="lazy" /><span>{ph.title}<em>Download</em></span></a>
        : <div class="arch empty"><span>Photo coming soon</span></div>)}
    </div>

    <div class="award-hl">
      <p class="mono">{awards.highlight.title}</p>
      {awards.highlight.image
        ? <figure class="hl-figure"><img src={awards.highlight.image} alt={`${awards.highlight.detail}, ${awards.highlight.title}`} loading="lazy" /><figcaption>{awards.highlight.caption}</figcaption></figure>
        : <p class="hl-title">{awards.highlight.detail}</p>}
    </div>

    <h3 class="h3 sub">{T.awards}</h3>
    <div class="award-grid">
      {awards.awards.map(a => (
        <div class="award">
          {a.image ? <img src={a.image} alt={`${a.prize}, ${a.org}`} loading="lazy" /> : <div class="seal" aria-hidden="true"><Glyph name="sun" size={34} color="var(--lgold)" /></div>}
          <p class="a-prize">{a.prize}</p>
          <p class="mono">{a.org}</p>
        </div>
      ))}
    </div>

    <h3 class="h3 sub">{T.stages}</h3>
    {press.performed_note && <p class="italic stages-note">{press.performed_note}</p>}
    <ul class="stages">
      {(press.performed || []).map(pl => <li><span class="st-place">{pl.place}</span><span class="mono">{[pl.city, pl.country, pl.year].filter(Boolean).join(' · ')}</span></li>)}
    </ul>

    <h3 class="h3 sub" id="videos">{T.watch}</h3>
  </div>
  <div class="shorts" aria-label="Short videos">
    {shortList.map(sh => sh.id
      ? <div class="short frame"><iframe src={`https://www.youtube-nocookie.com/embed/${sh.id}?rel=0&modestbranding=1&playsinline=1`} title={sh.title || 'NAOBA short'} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
      : <div class="short frame empty"><span>Short video</span></div>)}
  </div>
  <div class="wrap" style="margin-top:44px">
    <p class="center-text" style="margin-top:32px"><a class="btn" href={site.youtube}>{T.youtube_button}</a></p>
  </div>
</section>

<style>
.hero{position:relative;height:100vh;min-height:560px;overflow:hidden;display:grid;place-items:center}
.hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.shade{position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(0,0,0,.25) 0%,rgba(0,0,0,.72) 70%,#000 100%)}
.center{position:relative;z-index:2;text-align:center;padding:0 20px}
.logo{width:min(560px,82vw);height:auto;margin:0 auto;opacity:0;animation:rise 2.4s 1s ease forwards}
.italic.tag{font-family:'IM Fell English',Georgia,serif;font-style:italic;font-size:clamp(19px,2vw,23px);line-height:1.45}
.tag{margin:18px auto 0;text-align:center;opacity:0;animation:rise 2s 2.4s ease forwards}
.cue{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:2;font-family:var(--head);font-size:18px;text-decoration:none}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.logo,.tag{animation:none;opacity:1}}
.portal{height:calc(100vh - var(--navh));height:calc(100svh - var(--navh));min-height:560px;display:grid;grid-template-rows:3fr 2fr auto}
.doors{display:grid;grid-template-columns:1fr 1fr;min-height:0}
.door{position:relative;overflow:hidden;display:flex;align-items:flex-end;padding:clamp(22px,3.2vw,44px);min-height:0;text-decoration:none;border-top:1px solid var(--line)}
.door + .door{border-left:1px solid var(--line)}
.door img,.door video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.2s ease,filter 1.2s ease;filter:brightness(.55)}
.door:hover img,.door:hover video{transform:scale(1.04);filter:brightness(.72)}
.door::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.85),transparent 60%)}
.door .txt{position:relative;z-index:2}
.door .italic{margin:8px 0 14px;max-width:34ch}
.door .h1{font-size:clamp(38px,5.2vw,72px)}
.center-text{text-align:center}
.center-text .italic,.intro{margin:20px auto 0;max-width:44ch;text-align:center}
.players{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 28px}
.healing{text-align:center;max-width:62ch;margin:72px auto 8px}
.healing .h3{margin:14px 0 12px;font-size:30px}
.healing p{font-size:16px;line-height:1.75;margin:0}
@media (max-width:820px){.players{grid-template-columns:1fr}.healing{margin-top:52px}}
.small-doors{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}
.sdoor{position:relative;min-height:0;display:flex;flex-direction:column;justify-content:flex-end;padding:30px;text-decoration:none;overflow:hidden;border-right:1px solid var(--line)}
.sdoor:last-child{border-right:0}
.sdoor img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.42);transition:transform 1.2s ease,filter 1.2s ease}
.sdoor:hover img{transform:scale(1.04);filter:brightness(.6)}
.sdoor .h2,.sdoor .italic{position:relative;z-index:2;margin:0}
.sdoor .italic{font-size:17px}
.small-doors .sdoor .h2{font-size:clamp(26px,2.9vw,40px) !important;letter-spacing:.03em}
@media (max-width:820px){.portal{grid-template-rows:2fr 1fr}.doors{grid-template-columns:1fr;grid-template-rows:1fr 1fr}.door + .door{border-left:0}.door{padding:20px}.door .italic{font-size:15px;margin:4px 0 10px}.door .btn{padding:12px 18px;font-size:11px}.sdoor{padding:14px}.sdoor .h2{font-size:20px}.sdoor .italic{display:none}.small-doors{grid-template-columns:repeat(2,1fr)}.sdoor:nth-child(2){border-right:0}.sdoor:nth-child(-n+2){border-bottom:1px solid var(--line)}}
.listen-strip{display:flex;align-items:center;justify-content:center;gap:18px;padding:12px 20px;background:var(--obsidian);border-top:1px solid var(--line);text-decoration:none;color:var(--lgold)}
.listen-strip:hover .strip-text{color:var(--copal)}
.wave{display:flex;align-items:center;gap:3px;height:26px}
.wave i{display:block;width:3px;height:var(--h);background:var(--gold);border-radius:2px;transform-origin:center}
.strip-text{font-family:var(--head);font-size:19px;letter-spacing:.03em}
.arrow{font-size:20px}
@media (prefers-reduced-motion:no-preference){.wave i{animation:pulse 1.1s ease-in-out var(--d) infinite alternate}.arrow{animation:nudge 1.6s ease-in-out infinite}}
@keyframes pulse{from{transform:scaleY(.35)}to{transform:scaleY(1)}}
@keyframes nudge{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
.gigs li{align-items:center}
.book-box{border:1px solid var(--moss);padding:28px}
.press-btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.press-photo{position:relative;display:block;aspect-ratio:1;overflow:hidden;text-decoration:none;border:1px solid var(--line)}
.press-photo img{width:100%;height:100%;object-fit:cover;transition:filter .4s}
.press-photo span{position:absolute;left:0;right:0;bottom:0;padding:8px 10px;font-size:13px;line-height:1.35;color:var(--maize);background:linear-gradient(to top,rgba(0,0,0,.85),transparent)}
.press-photo em{color:var(--lgold);font-style:normal}
.press-photo:hover img{filter:brightness(.7)}
@media (max-width:820px){.photo-grid{grid-template-columns:repeat(2,1fr)}.wave{display:none}.strip-text{font-size:16px}}
.tm{font-size:.55em;vertical-align:super;line-height:0;margin-left:1px}
.hero .cue{position:static;transform:none;margin-top:30px;font:500 12px/1 var(--sans);letter-spacing:.22em;opacity:0;animation:rise 2s 3s ease forwards}
@media (prefers-reduced-motion:reduce){.hero .cue{animation:none;opacity:1}}
.intro-band{padding:120px 0}
.marquee{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:26px 0;background:var(--bg)}
.marquee .track{display:flex;gap:42px;white-space:nowrap;width:max-content;font:400 clamp(30px,4vw,52px)/1 var(--title);letter-spacing:.05em;color:var(--gold)}
.marquee i{font-style:normal;font-size:.5em;align-self:center;color:var(--lgold)}
@media (prefers-reduced-motion:no-preference){.marquee .track{animation:slide 60s linear infinite}}
@keyframes slide{to{transform:translateX(-50%)}}
.reel{position:relative;background:#000}
.sound-btn{position:absolute;right:18px;bottom:18px;z-index:2;font:500 11px/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:#F6EFE0;background:rgba(0,0,0,.45);border:1px solid rgba(246,239,224,.5);padding:10px 14px;cursor:pointer;backdrop-filter:blur(4px)}
.sound-btn[aria-pressed="true"]{background:var(--gold);color:#1a1510;border-color:var(--gold)}
.reel video{width:100%;max-height:88vh;aspect-ratio:16/9;object-fit:cover;background:#000}
.reel-cap{position:absolute;left:0;right:0;top:0;padding:48px 28px;text-align:center;pointer-events:none;background:linear-gradient(to bottom,rgba(0,0,0,.6),transparent)}
.reel-cap .mono{color:#E6C37F;margin:0 0 8px}
.reel-cap .h2{color:#F6EFE0;margin:0}
.press-photo span{color:#EFE3C8}
.press-photo em{color:#E6C37F}
.reel-band{background:var(--bg);padding:0}

.reel-head .mono{margin:0 0 10px}
.reel-head .h2{margin:0}
.reel{background:#000}
.reel video{width:100%;max-height:86vh;aspect-ratio:16/9;object-fit:cover;background:#000 center/cover no-repeat}
.shorts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px;max-width:74rem;margin:56px auto 0;padding:0 28px}
.short{aspect-ratio:9/16;background:#0F2619;overflow:visible}
.short iframe{width:100%;height:100%;border:0;display:block}
.short.empty{display:grid;place-items:center;border:1px dashed var(--gold);background:transparent}
.short.empty span{font:400 11px/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--lgold)}
@media (max-width:820px){
  .shorts{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;padding:0 20px 8px;margin-top:40px;-webkit-overflow-scrolling:touch}
  .short{flex:0 0 62%;scroll-snap-align:center}
  .reel-band{padding-top:64px}
  .reel video{max-height:none}
}
.tribe{background:var(--bg);padding:72px 0;border-top:1px solid var(--line)}
.bc-albums{display:flex;flex-wrap:wrap;justify-content:center;gap:28px;margin-top:40px}
.bc{border:0;width:350px;max-width:100%;height:470px;background:#fff}
.bit-wrap{max-width:820px;margin:0 auto 32px;font-family:var(--sans)}
.award-hl{margin:80px 0 48px}
.hl-title{font:400 clamp(44px,6vw,80px)/1.05 var(--title);letter-spacing:.04em;color:var(--lgold);margin:0}
#press .h3{margin-bottom:14px}
#press .photo-grid{grid-template-columns:repeat(3,1fr)}
@media (max-width:820px){.tribe{padding:56px 0}.award-hl{margin:56px 0 36px}}
.press .press-bio{max-width:62ch;margin:18px auto 0;font-size:17px}
.press .press-btns{justify-content:center}
.press .sub{margin:84px 0 30px;font-size:32px}
.arches{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 22px;max-width:1080px;margin:0 auto}
.arch{position:relative;display:block;aspect-ratio:3/2;border-radius:0;overflow:hidden;outline:1px solid rgba(240,198,124,.5);outline-offset:6px;text-decoration:none;background:#0b1a11}
.arch img{width:100%;height:100%;object-fit:cover;object-position:center 28%;transition:transform 1.2s ease,filter .6s}
.arch:hover img{transform:scale(1.04);filter:brightness(.8)}
.arch span{position:absolute;left:0;right:0;bottom:0;padding:26px 12px 14px;font-size:13px;line-height:1.4;color:#EFE3C8;background:linear-gradient(to top,rgba(0,0,0,.8),transparent)}
.arch em{display:block;font:500 10px/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:#E6C37F;margin-top:6px;font-style:normal}
.arch.empty{display:grid;place-items:center;outline-style:dashed;background:transparent}
.arch.empty span{position:static;background:none;padding:0;font:400 10px/1.4 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:#E6C37F}
.award-hl{margin:96px auto 0;max-width:620px}
.hl-figure{margin:16px auto 0;padding:14px;border:1px solid rgba(240,198,124,.45)}
.hl-figure img{width:100%;height:auto}
.hl-figure figcaption{font:400 11px/1.5 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:#E6C37F;margin-top:14px}
.award-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:22px;max-width:1000px;margin:0 auto}
.award-grid .award{flex:0 1 220px}
.award{border:1px solid rgba(240,198,124,.25);padding:28px 18px 22px;display:flex;flex-direction:column;align-items:center;gap:10px}
.award img{width:100%;aspect-ratio:1;object-fit:contain}
.seal{width:84px;height:84px;border-radius:50%;border:1px solid rgba(240,198,124,.5);display:grid;place-items:center;margin-bottom:4px}
.a-prize{font:400 22px/1.2 var(--title);letter-spacing:.03em;color:#F6EFE0;margin:0}
.award .mono{margin:0}
.stages{list-style:none;padding:0;margin:0 auto;max-width:900px;display:grid;grid-template-columns:1fr 1fr;column-gap:48px}
@media (max-width:700px){.stages{grid-template-columns:1fr}}
.stages-note{margin:-6px auto 26px;opacity:.8}
.stages li{display:flex;flex-direction:column;gap:3px;padding:11px 0;border-top:1px solid rgba(240,198,124,.2)}
.stages li:nth-last-child(-n+2){border-bottom:1px solid rgba(240,198,124,.2)}
.st-place{font:400 24px/1.2 var(--title);color:#F6EFE0}
.press .shorts{margin-top:0}
.press .short.empty{border-color:rgba(240,198,124,.5)}
@media (max-width:820px){.arches{grid-template-columns:1fr;gap:22px;max-width:480px}.press .sub{margin:60px 0 24px}.award-grid{gap:14px}.award-grid .award{flex:0 1 calc(50% - 7px)}.award{padding:20px 10px}.a-prize{font-size:18px}}
.hero-geo{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;z-index:1}
.hero-geo svg{width:min(92vw,760px);height:auto}
.hero .center{position:relative;z-index:2}
.geo-bg{position:relative;overflow:hidden}
.geo-mark{position:absolute;right:-140px;top:50%;transform:translateY(-50%);pointer-events:none}
.geo-bg .wrap{position:relative;z-index:1}
